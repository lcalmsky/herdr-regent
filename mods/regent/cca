#!/bin/sh
# cca — Claude Code accounts: list them, run claude under one, add an account,
# and share session history between accounts.

set -u

TOWER="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-tower"
# Shared with the control-tower copy: the usage-tap hook writes here.
STATE="$TOWER/usage"
# Resolved through a link, since cca is often linked onto PATH away from usage-api.mjs.
HERE=$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || printf %s "$0")")" && pwd)
CURRENT="$TOWER/current"
CODEX_CURRENT="$TOWER/codex-current"
LABELS="$TOWER/labels"
SHARED="projects history.jsonl file-history todos plans tasks teams paste-cache session-env sessions"

die() { printf 'cca: %s\n' "$*" >&2; exit 1; }

# Exit with a specific code, for the statuses the app and tidemark branch on.
die_as() { code=$1; shift; printf 'cca: %s\n' "$*" >&2; exit "$code"; }

reserved_name() {
  case "$1" in ls|add|share|use|current|shell-init|help|'-'*) return 0 ;; esac
  return 1
}

# A models.json entry may be named codex, but a folder may not: the `cca codex ...` subcommand
# owns the word.
folder_reserved() {
  case "$1" in codex) return 0 ;; esac
  return 1
}

# A model from models.json counts wherever an account name does, but has no config folder.
model_exists() {
  command -v node >/dev/null 2>&1 || return 1
  node "$HERE/models.mjs" exists "$TOWER" "$1" >/dev/null 2>&1
}

valid_name() {
  case "$1" in ''|*[!A-Za-z0-9_-]*) return 1 ;; esac
  reserved_name "$1" && return 1
  return 0
}

acct_name() {
  case "$1" in
    "$HOME/.claude") printf 'default\n' ;;
    "$HOME"/.claude-accounts/*) b=${1%/}; printf '%s\n' "${b##*/}" ;;
    *) b=${1%/}; printf '%s\n' "${b##*/}" ;;
  esac
}

current_account() {
  d=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
  d=${d%/}
  acct_name "$d"
}

# The global default the shell hook and tidemark read: the account or model every new session
# starts under. A missing, invalid or since-deleted choice reads as default.
current_default() {
  name=
  if [ -r "$CURRENT" ]; then
    IFS= read -r name < "$CURRENT" || [ -n "$name" ] || name=
  fi
  if [ -n "$name" ] && [ "$name" != default ]; then
    if valid_name "$name"; then
      [ -d "$HOME/.claude-accounts/$name" ] || model_exists "$name" || name=
    else
      name=
    fi
  fi
  printf '%s\n' "${name:-default}"
}

# The Codex account new sessions start under, read the same way: missing, invalid or since-deleted
# reads as default, which is ~/.codex itself.
current_codex() {
  name=
  if [ -r "$CODEX_CURRENT" ]; then
    IFS= read -r name < "$CODEX_CURRENT" || [ -n "$name" ] || name=
  fi
  if [ -n "$name" ] && [ "$name" != default ]; then
    if valid_name "$name" && [ -d "$HOME/.codex-accounts/$name" ]; then :
    else name=
    fi
  fi
  printf '%s\n' "${name:-default}"
}

# The label shown in place of an account's name; absent reads as no label.
label_of() {
  [ -r "$LABELS" ] || return 1
  v=$(awk -F '\t' -v n="$1" '$1 == n { print $2; exit }' "$LABELS" 2>/dev/null)
  [ -n "$v" ] || return 1
  printf '%s\n' "$v"
}

# "label (name)" when the account has a label, else the name.
display_name() {
  l=$(label_of "$1") && { printf '%s (%s)\n' "$l" "$1"; return; }
  printf '%s\n' "$1"
}

# A label is 1-24 printable characters and never holds a tab or newline.
valid_label() {
  [ -n "$1" ] || return 1
  case "$1" in *[[:cntrl:]]*) return 1 ;; esac
  [ "${#1}" -le 24 ] || return 1
  return 0
}

email() {
  if [ -f "$1" ]; then
    e=$(grep -oE '"emailAddress"[[:space:]]*:[[:space:]]*"([^"\\]|\\.)*"' "$1" 2>/dev/null | head -n 1 | sed -E 's/^"emailAddress"[[:space:]]*:[[:space:]]*"//; s/"$//' | tr -d '\000-\037')
    if [ -n "$e" ]; then printf '%s\n' "$e"; return; fi
  fi
  printf 'not signed in\n'
}

val() {
  printf '%s' "$1" | grep -o "\"$2\":[0-9][0-9.]*" 2>/dev/null | head -n 1 | cut -d: -f2
}

# "used resets_at" for one window, with a window past its reset read as 0 %.
usage_get() {
  f="$STATE/$1.json"
  [ -f "$f" ] || return 1
  obj=$(grep -o "\"$2\":{[^}]*}" "$f" 2>/dev/null | head -n 1)
  [ -n "$obj" ] || return 1
  used=$(val "$obj" used)
  [ -n "$used" ] || return 1
  reset=$(val "$obj" resets_at)
  if [ -n "$reset" ] && [ "$reset" -le "$(date +%s)" ] 2>/dev/null; then
    printf '0 \n'
  else
    printf '%s %s\n' "$used" "$reset"
  fi
}

hhmm() {
  if date -r "$1" +%H:%M >/dev/null 2>&1; then
    date -r "$1" +%H:%M
  else
    date -d "@$1" +%H:%M 2>/dev/null
  fi
}

pct_of() { printf '%.0f' "$1" 2>/dev/null || printf '%s' "$1"; }

# JSON strings for `cca ls --json`: backslash and quote escaped, control characters dropped.
json_esc() {
  printf '%s' "$1" | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

json_email() {
  e=$(email "$1")
  if [ "$e" = "not signed in" ]; then
    printf 'null'
  else
    # email() returns the value as written in .claude.json, already JSON-escaped; pass it only if it is a valid JSON string body.
    if printf '%s' "$e" | grep -qE '^([^"\\]|\\["\\/bfnrt]|\\u[0-9a-fA-F]{4})*$'; then
      printf '"%s"' "$e"
    else
      printf 'null'
    fi
  fi
}

# One window as JSON, or null. A window past its reset reads as 0 % and keeps its reset time.
json_window() {
  f="$STATE/$1.json"
  [ -f "$f" ] || { printf 'null'; return 0; }
  obj=$(grep -o "\"$2\":{[^}]*}" "$f" 2>/dev/null | head -n 1)
  used=$(val "$obj" used)
  if [ -z "$obj" ] || [ -z "$used" ]; then printf 'null'; return 0; fi
  reset=$(val "$obj" resets_at)
  if [ -n "$reset" ] && [ "$reset" -le "$(date +%s)" ] 2>/dev/null; then
    used=0
  fi
  if [ -n "$reset" ]; then
    printf '{"used":%s,"resets_at":%s}' "$used" "$reset"
  else
    printf '{"used":%s,"resets_at":null}' "$used"
  fi
}

json_updated() {
  f="$STATE/$1.json"
  [ -f "$f" ] || { printf 'null'; return 0; }
  u=$(grep -o '"updated_at":[0-9][0-9.]*' "$f" 2>/dev/null | head -n 1 | cut -d: -f2)
  if [ -n "$u" ]; then printf '%s' "$u"; else printf 'null'; fi
}

# One cell of the table, padded to $3 columns: "12%", "94% ↻15:20" or "–". The ↻ and – are
# multibyte but one column each, so the width is counted from the parts rather than with ${#}.
usage_cell() {
  width=$3
  if ! vals=$(usage_get "$1" "$2"); then
    printf '–'
    n=$((width - 1))
  else
    used=${vals%% *}
    reset=${vals#* }
    pct=$(pct_of "$used")
    if [ -n "$reset" ] && [ "$pct" -ge 90 ] 2>/dev/null; then
      printf '%s%% ↻%s' "$pct" "$(hhmm "$reset")"
      n=$((width - ${#pct} - 8))
    else
      printf '%s%%' "$pct"
      n=$((width - ${#pct} - 1))
    fi
  fi
  while [ "$n" -gt 0 ]; do printf ' '; n=$((n - 1)); done
}

# Resets only exist when the terminal (and the person) can show color.
color=
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  OFF=$(printf '\033[0m')
  BOLD=$(printf '\033[1m')
  DIM=$(printf '\033[2m')
  AMBER=$(printf '\033[33m')
  RED=$(printf '\033[31m')
else
  OFF= BOLD= DIM= AMBER= RED=
fi

# One line of JSON for tidemark: the global default, then every account with its email, both
# windows and the most-5h-headroom flag, in the same order and with the same rule as the table.
cmd_ls_json() {
  gdef=$(current_default)
  best_name=
  best_used=
  json_scan() {
    vals=$(usage_get "$1" five_hour) || return 0
    used=${vals%% *}
    if [ -z "$best_used" ] || awk -v a="$used" -v b="$best_used" 'BEGIN { exit !(a + 0 < b + 0) }'; then
      best_used=$used
      best_name=$1
    fi
  }
  json_scan default
  for d in "$HOME"/.claude-accounts/*/; do
    [ -d "$d" ] || continue
    n=${d%/}
    n=${n##*/}
    [ "$n" = default ] && continue
    valid_name "$n" || continue
    json_scan "$n"
  done

  printf '{"current":"%s","accounts":[' "$(json_esc "$gdef")"
  sep=
  json_row() {
    best=false
    [ "$1" = "$best_name" ] && best=true
    printf '%s{"name":"%s","email":%s,"five_hour":%s,"seven_day":%s,"updated_at":%s,"best":%s}' \
      "$sep" "$(json_esc "$1")" "$(json_email "$2")" \
      "$(json_window "$1" five_hour)" "$(json_window "$1" seven_day)" \
      "$(json_updated "$1")" "$best"
    sep=,
  }
  json_row default "$HOME/.claude.json"
  for d in "$HOME"/.claude-accounts/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    n=${d##*/}
    [ "$n" = default ] && continue
    valid_name "$n" || continue
    json_row "$n" "$d/.claude.json"
  done
  printf ']}\n'
}

cmd_ls() {
  if [ "${1:-}" = --json ]; then
    cmd_ls_json
    return
  fi
  cur=$(current_account)
  best_name=
  best_used=
  printf '%s  %-11.11s %-21.21s %-11.11s %-11.11s%s\n' "$DIM" "NAME" "EMAIL" "5H" "7D" "$OFF"
  row() {
    printf '%s%-1.1s%s ' "$AMBER" "$3" "$OFF"
    printf '%s%-11s%s ' "$BOLD" "$(display_name "$1")" "$OFF"
    printf '%s%-21.21s%s ' "$DIM" "$2" "$OFF"
    printf '%s' "$4"; usage_cell "$1" five_hour 11; printf '%s ' "$OFF"
    printf '%s' "$DIM"; usage_cell "$1" seven_day 11; printf '%s\n' "$OFF"
  }
  show() {
    name=$1 file=$2
    mark=
    [ "$name" = "$cur" ] && mark='*'
    mail=$(email "$file")
    fivecolor=
    vals=$(usage_get "$name" five_hour) && {
      used=${vals%% *}
      if [ -z "$best_used" ] || awk -v a="$used" -v b="$best_used" 'BEGIN { exit !(a + 0 < b + 0) }'; then
        best_used=$used
        best_name=$name
      fi
      [ "$(pct_of "$used")" -ge 100 ] 2>/dev/null && fivecolor=$RED
    }
    row "$name" "$mail" "$mark" "$fivecolor"
  }
  show default "$HOME/.claude.json"
  for d in "$HOME"/.claude-accounts/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    n=${d##*/}
    [ "$n" = default ] && continue
    valid_name "$n" || continue
    show "$n" "$d/.claude.json"
  done
  printf '\n'
  if [ -n "$best_name" ]; then
    printf 'Most 5h headroom: %s%s%s\n' "$BOLD" "$(display_name "$best_name")" "$OFF"
  else
    printf 'Most 5h headroom: –\n'
  fi
}

usage_line() {
  f="$STATE/$1.json"
  api="$STATE/$1.api.json"
  [ -f "$f" ] || [ -f "$api" ] || return 0
  five=$(grep -o '"five_hour":{[^}]*}' "$f" 2>/dev/null | head -n 1)
  seven=$(grep -o '"seven_day":{[^}]*}' "$f" 2>/dev/null | head -n 1)
  fable=$(grep -o '"fable":{[^}]*}' "$api" 2>/dev/null | head -n 1)
  printf 'U\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$(val "$five" used)" "$(val "$five" resets_at)" \
    "$(val "$seven" used)" "$(val "$seven" resets_at)" "$(val "$fable" used)" "$(val "$fable" resets_at)"
}

plan_line() {
  [ -f "$2" ] || return 0
  p=$(grep -oE '"planDisplayName"[[:space:]]*:[[:space:]]*"[^"]*"' "$2" 2>/dev/null | head -n 1 | sed -E 's/.*:[[:space:]]*"//; s/"$//' | tr -d '\000-\037')
  [ -n "$p" ] && printf 'P\t%s\t%s\n' "$1" "$p"
  return 0
}

# The status line carries only the 5h and 7d windows, so the Fable weekly window comes from the
# usage endpoint /usage reads, with the token Claude Code keeps in the keychain for that config dir.
# It is written to <name>.api.json, apart from the file usage-tap.sh rewrites.
api_fetch() {
  name=$1 dir=$2
  if [ "$name" = default ]; then svc="Claude Code-credentials"
  else svc="Claude Code-credentials-$(printf '%s' "$dir" | shasum -a 256 | cut -c1-8)"; fi
  creds=$(security find-generic-password -s "$svc" -w 2>/dev/null) || return 0
  body=$(printf '%s' "$creds" | node "$HERE/usage-api.mjs" 2>/dev/null) || return 0
  [ -n "$body" ] || return 0
  mkdir -p "$STATE" && printf '%s' "$body" > "$STATE/$name.api.json.tmp.$$" && mv "$STATE/$name.api.json.tmp.$$" "$STATE/$name.api.json"
}

# At most every 5 minutes, in the background so the porcelain read never waits on the network.
api_refresh() {
  command -v node >/dev/null 2>&1 && command -v security >/dev/null 2>&1 || return 0
  mkdir -p "$STATE" 2>/dev/null || return 0
  stamp="$STATE/.api-fetch"
  [ -n "$(find "$stamp" -mmin -5 2>/dev/null)" ] && return 0
  : > "$stamp"
  (
    api_fetch default "$HOME/.claude"
    for d in "$HOME"/.claude-accounts/*/; do
      d=${d%/}
      [ -d "$d" ] && valid_name "${d##*/}" && [ "${d##*/}" != default ] || continue
      api_fetch "${d##*/}" "$d"
    done
  ) </dev/null >/dev/null 2>&1 &
}

porcelain_label() {
  l=$(label_of "$1") || return 0
  printf 'L\t%s\t%s\n' "$1" "$l"
}

# One Codex home: its login, the usage codex-usage.mjs reads from it, and its label under the
# codex: prefix.
codex_row() {
  cname=$1 chome=$2
  cemail=
  [ -n "$have_node" ] && cemail=$(node "$HERE/codex-usage.mjs" --email "$chome" 2>/dev/null)
  printf 'X\t%s\t%s\n' "$cname" "$cemail"
  if [ -n "$have_node" ]; then
    cusage=$(node "$HERE/codex-usage.mjs" "$chome" 2>/dev/null) || cusage=
    if [ -n "$cusage" ]; then
      printf 'V\t%s\t%s\t%s\t%s\t%s\n' "$cname" \
        "$(printf '%s\n' "$cusage" | cut -f1)" "$(printf '%s\n' "$cusage" | cut -f2)" \
        "$(printf '%s\n' "$cusage" | cut -f3)" "$(printf '%s\n' "$cusage" | cut -f4)"
      cplan=$(printf '%s\n' "$cusage" | cut -f5)
      if [ -n "$cplan" ]; then
        cfirst=$(printf '%s' "$cplan" | cut -c1 | tr '[:lower:]' '[:upper:]')
        crest=$(printf '%s' "$cplan" | cut -c2-)
        printf 'Q\t%s\tChatGPT %s%s\n' "$cname" "$cfirst" "$crest"
      fi
    fi
  fi
  porcelain_label "codex:$cname"
}

# Nothing to report, and no node run, when neither home exists.
codex_lines() {
  [ -d "$HOME/.codex" ] || [ -d "$HOME/.codex-accounts" ] || return 0
  printf 'Y\t%s\n' "$(current_codex)"
  have_node=
  command -v node >/dev/null 2>&1 && have_node=1
  codex_row default "$HOME/.codex"
  for d in "$HOME"/.codex-accounts/*/; do
    [ -d "$d" ] || continue
    d=${d%/}
    n=${d##*/}
    [ "$n" = default ] && continue
    valid_name "$n" || continue
    codex_row "$n" "$d"
  done
}

cmd_porcelain() {
  pid=${1:-}
  case "$pid" in *[!0-9]*) pid= ;; esac
  cur=default
  envs=
  if [ -n "$pid" ]; then
    # Tests point CCA_PS at a stub because the sandbox's ps -E shows no environment.
    envs=$(${CCA_PS:-ps} -E -ww -p "$pid" -o command= 2>/dev/null | tr ' ' '\n')
    d=$(printf '%s\n' "$envs" | grep '^CLAUDE_CONFIG_DIR=' | tail -n 1 | cut -d= -f2-)
    d=${d%/}
    cur=$(acct_name "${d:-$HOME/.claude}")
  fi
  # Models are read before C so a pane running one reports it instead of the account it borrows.
  models_out=
  if command -v node >/dev/null 2>&1; then
    models_out=$(printf '%s\n' "$envs" | node "$HERE/models.mjs" porcelain "$TOWER" "$HERE" 2>/dev/null)
    m=$(printf '%s\n' "$models_out" | awk -F '\t' '$1 == "C" { print $2; exit }')
    [ -n "$m" ] && cur=$m
  fi
  printf 'C\t%s\n' "$cur"
  printf 'D\t%s\n' "$(current_default)"
  api_refresh
  printf 'A\tdefault\t%s\n' "$(email "$HOME/.claude.json")"
  porcelain_label default
  plan_line default "$HOME/.claude.json"
  usage_line default
  for d in "$HOME"/.claude-accounts/*/; do
    d=${d%/}
    [ -d "$d" ] && [ "${d##*/}" != default ] || continue
    valid_name "${d##*/}" || continue
    printf 'A\t%s\t%s\n' "${d##*/}" "$(email "$d/.claude.json")"
    porcelain_label "${d##*/}"
    plan_line "${d##*/}" "$d/.claude.json"
    usage_line "${d##*/}"
  done
  if [ -n "$models_out" ]; then
    printf '%s\n' "$models_out" | while IFS= read -r line; do
      case "$line" in
        ''|C*) continue ;;
        *) printf '%s\n' "$line" ;;
      esac
    done
    # After models.mjs's own L lines, so a rename in the labels file still wins in main.js.
    for id in $(printf '%s\n' "$models_out" | awk -F '\t' '$1 == "M" { print $2 }'); do
      porcelain_label "$id"
    done
  fi
  codex_lines
  if [ -n "$pid" ]; then
    sf="$HOME/.claude/sessions/$pid.json"
    if [ -f "$sf" ]; then
      sid=$(head -c 65536 "$sf" 2>/dev/null | grep -oE '"sessionId" *: *"[0-9a-fA-F-]{36}"' | grep -oE '[0-9a-fA-F-]{36}' | head -n 1)
      cwd=$(head -c 65536 "$sf" 2>/dev/null | grep -oE '"cwd" *: *"[^"]*"' | head -n 1 | sed 's/.*: *"//; s/"$//')
      [ -n "$sid" ] && [ -n "$cwd" ] && printf 'S\t%s\t%s\n' "$sid" "$cwd"
    fi
  fi
}

# A new account is a config dir of its own: everything in ~/.claude is linked in except login and
# per-session state. Session history is linked too, so every account sees the same transcripts.
make_account() {
  name=$1
  [ "$name" = default ] && { printf 'default is the ~/.claude account.\n' >&2; return 2; }
  reserved_name "$name" && { printf '%s is a cca command.\n' "$name" >&2; return 2; }
  folder_reserved "$name" && { printf '%s is a cca command.\n' "$name" >&2; return 2; }
  valid_name "$name" || { printf 'Use letters, digits, - or _.\n' >&2; return 2; }
  model_exists "$name" && { printf '%s is a model.\n' "$name" >&2; return 2; }
  dir="$HOME/.claude-accounts/$name"
  [ -e "$dir" ] && { printf '%s already exists.\n' "$name" >&2; return 3; }
  mkdir -p "$dir" || { printf 'Could not create %s.\n' "$dir" >&2; return 4; }
  # The shared entries are created under ~/.claude first: a missing link target would make Claude
  # Code keep a private copy inside the account folder, and the history would split.
  for x in projects file-history todos plans tasks teams paste-cache session-env sessions; do
    mkdir -p "$HOME/.claude/$x" || { rm -rf "$dir"; printf 'Could not create ~/.claude/%s.\n' "$x" >&2; return 4; }
  done
  [ -e "$HOME/.claude/history.jsonl" ] || : > "$HOME/.claude/history.jsonl" || { rm -rf "$dir"; printf 'Could not create ~/.claude/history.jsonl.\n' >&2; return 4; }
  for src in "$HOME"/.claude/* "$HOME"/.claude/.[!.]*; do
    [ -e "$src" ] || continue
    x=${src##*/}
    case "$x" in
      .credentials.json|.claude.json|shell-snapshots|statsig|ide|debug|backups|telemetry|cache|transcripts|jobs|logs|daemon*|.session-stats.json|.last-*|*.lock) continue ;;
    esac
    ln -s "$src" "$dir/$x" || { rm -rf "$dir"; printf 'Could not link %s.\n' "$x" >&2; return 5; }
  done
  return 0
}

# A Codex account is a CODEX_HOME of its own: config and session history are linked in, while
# login and per-machine state stay behind so the two logins never share them.
make_codex_account() {
  name=$1
  [ "$name" = default ] && { printf 'default is the ~/.codex account.\n' >&2; return 2; }
  reserved_name "$name" && { printf '%s is a cca command.\n' "$name" >&2; return 2; }
  valid_name "$name" || { printf 'Use letters, digits, - or _.\n' >&2; return 2; }
  folder_reserved "$name" && { printf '%s is a cca command.\n' "$name" >&2; return 2; }
  dir="$HOME/.codex-accounts/$name"
  [ -e "$dir" ] && { printf '%s already exists.\n' "$name" >&2; return 3; }
  mkdir -p "$dir" || { printf 'Could not create %s.\n' "$dir" >&2; return 4; }
  # The session folders must exist under ~/.codex first, or Codex keeps a private copy inside the
  # account folder and the history splits.
  for x in sessions archived_sessions; do
    mkdir -p "$HOME/.codex/$x" || { rm -rf "$dir"; printf 'Could not create ~/.codex/%s.\n' "$x" >&2; return 4; }
  done
  [ -e "$HOME/.codex/history.jsonl" ] || : > "$HOME/.codex/history.jsonl" || { rm -rf "$dir"; printf 'Could not create ~/.codex/history.jsonl.\n' >&2; return 4; }
  for src in "$HOME"/.codex/* "$HOME"/.codex/.[!.]*; do
    [ -e "$src" ] || continue
    x=${src##*/}
    case "$x" in
      auth.json|.codex-global-state.json*|*.sqlite|*.sqlite-*|.sqlite-maintenance.lock|*.lock|.tmp|ipc|log|logs|cache|computer-use|browser|.hook-trust|installation_id) continue ;;
    esac
    ln -s "$src" "$dir/$x" || { rm -rf "$dir"; printf 'Could not link %s.\n' "$x" >&2; return 5; }
  done
  return 0
}

cmd_add() {
  name=${1:-}
  make_account "$name" || exit $?
  printf 'Created ~/.claude-accounts/%s.\n' "$name"
  printf 'Log in with: cca %s\n' "$name"
}

cmd_codex_add() {
  name=${1:-}
  make_codex_account "$name" || exit $?
  printf 'Created ~/.codex-accounts/%s.\n' "$name"
  printf 'Log in with: CODEX_HOME=~/.codex-accounts/%s codex login\n' "$name"
}

cmd_porcelain_add_codex() {
  name=${1:-}
  make_codex_account "$name" || exit $?
  printf '%s\n' "$HOME/.codex-accounts/$name"
}

cmd_porcelain_add() {
  name=${1:-}
  make_account "$name" || exit $?
  printf '%s\n' "$HOME/.claude-accounts/$name"
}

# The add-model form's one write: models.mjs owns validation so the app and the file agree.
cmd_porcelain_add_model() {
  label=${1-}
  command=${2-}
  command -v node >/dev/null 2>&1 || die "node is required to add a model"
  node "$HERE/models.mjs" add "$TOWER" "$label" "$command"
}

# Links an account made before sharing existed into the shared history. It merges into ~/.claude
# without overwriting, keeps the account's copy beside it, and only then creates the symlink.
cmd_share() {
  dry=
  name=
  for a in "$@"; do
    case "$a" in
      --dry-run) dry=1 ;;
      *) if [ -z "$name" ]; then name=$a; else die "usage: cca share [--dry-run] <name>"; fi ;;
    esac
  done
  [ "$name" = default ] && die "default is ~/.claude itself."
  reserved_name "$name" && die "$name is a cca command."
  folder_reserved "$name" && die "$name is a cca command."
  valid_name "$name" || die "Use letters, digits, - or _."
  dir="$HOME/.claude-accounts/$name"
  [ -d "$dir" ] || die "No account $name."
  epoch=$(date +%s)
  for x in $SHARED; do
    dst="$dir/$x"
    src="$HOME/.claude/$x"
    if [ -L "$dst" ]; then
      target=$(readlink "$dst" 2>/dev/null)
      if [ "$target" = "$src" ] || [ "$dst" -ef "$src" ]; then
        printf '%-12s already shared\n' "$x"
      else
        die "$x links elsewhere: $target"
      fi
      continue
    fi
    if [ -e "$dst" ]; then
      if [ -d "$dst" ]; then
        verb=merge
      else
        verb=append
      fi
      printf '%-12s %s into ~/.claude/%s, move the copy to %s.pre-share-%s, link it\n' "$x" "$verb" "$x" "$x" "$epoch"
      if [ -z "$dry" ]; then
        [ -e "$dst.pre-share-$epoch" ] && die "$x.pre-share-$epoch already exists"
        if [ -d "$dst" ]; then
          mkdir -p "$src" || die "Could not create ~/.claude/$x"
          # BSD cp -n exits 1 when it merely skips an existing file, so judge by its message.
          msg=$( (cd "$dst" && cp -Rn . "$src/") 2>&1 >/dev/null )
          [ -z "$msg" ] || die "Could not merge $x: $msg"
        else
          [ -e "$src" ] || : > "$src" || die "Could not create ~/.claude/$x"
          cat "$dst" >> "$src" || die "Could not append $x"
        fi
        mv "$dst" "$dst.pre-share-$epoch" || die "Could not move $x aside"
        ln -s "$src" "$dst" || die "Could not link $x"
      fi
    else
      printf '%-12s link (nothing to merge)\n' "$x"
      if [ -z "$dry" ]; then
        if [ -d "$src" ]; then
          :
        elif [ "$x" = history.jsonl ]; then
          [ -e "$src" ] || : > "$src" || die "Could not create ~/.claude/$x"
        else
          mkdir -p "$src" || die "Could not create ~/.claude/$x"
        fi
        ln -s "$src" "$dst" || die "Could not link $x"
      fi
    fi
  done
  [ -n "$dry" ] && printf 'dry run: nothing changed\n'
  return 0
}

cmd_run() {
  name=$1
  shift
  reserved_name "$name" && die "$name is a cca command."
  folder_reserved "$name" && die "$name is a cca command."
  valid_name "$name" || die "Use letters, digits, - or _."
  if [ "$name" = default ]; then
    unset CLAUDE_CONFIG_DIR
  else
    dir="$HOME/.claude-accounts/$name"
    [ -d "$dir" ] || die "No account $name. Create it with: cca add $name"
    CLAUDE_CONFIG_DIR="$dir"
    export CLAUDE_CONFIG_DIR
  fi
  # An explicit choice wins over the shell hook's global default for the session this starts.
  CCA_ACCOUNT=$name
  export CCA_ACCOUNT
  command -v claude >/dev/null 2>&1 || die "claude is not on PATH."
  exec claude "$@"
}

cmd_current() {
  current_default
}

# Sets the account or model every new session starts under. Exit 2: unusable name, 3: no such
# account or model.
cmd_use() {
  name=${1:-}
  if [ -z "$name" ]; then
    die_as 2 "usage: cca use <name>"
  fi
  if [ "$name" != default ]; then
    if valid_name "$name" && [ -d "$HOME/.claude-accounts/$name" ]; then :
    elif model_exists "$name"; then :
    elif valid_name "$name"; then die_as 3 "No account or agent $name."
    else die_as 2 "Use letters, digits, - or _."
    fi
  fi
  mkdir -p "$TOWER" || die_as 1 "Could not create $TOWER."
  tmp="$TOWER/.current.$$"
  printf '%s\n' "$name" > "$tmp" || { rm -f "$tmp"; die_as 1 "Could not write $CURRENT."; }
  mv "$tmp" "$CURRENT" || { rm -f "$tmp"; die_as 1 "Could not write $CURRENT."; }
  printf '%s\n' "$name"
}

# The Codex half of cmd_use: default or an existing ~/.codex-accounts/<name>. Exit 2: unusable
# name, 3: no such account.
cmd_codex_use() {
  name=${1:-}
  if [ -z "$name" ]; then
    die_as 2 "usage: cca codex use <name>"
  fi
  if [ "$name" != default ]; then
    if valid_name "$name" && [ -d "$HOME/.codex-accounts/$name" ]; then :
    elif ! valid_name "$name"; then die_as 2 "Use letters, digits, - or _."
    else die_as 3 "No Codex account $name."
    fi
  fi
  mkdir -p "$TOWER" || die_as 1 "Could not create $TOWER."
  tmp="$TOWER/.codex-current.$$"
  printf '%s\n' "$name" > "$tmp" || { rm -f "$tmp"; die_as 1 "Could not write $CODEX_CURRENT."; }
  mv "$tmp" "$CODEX_CURRENT" || { rm -f "$tmp"; die_as 1 "Could not write $CODEX_CURRENT."; }
  printf '%s\n' "$name"
}

cmd_codex() {
  case "${1:-}" in
    use) shift; cmd_codex_use "${1:-}" ;;
    add) shift; cmd_codex_add "${1:-}" ;;
    *) die "usage: cca codex use <name> | cca codex add <name>" ;;
  esac
}

# Sets the display label shown in place of the name; an empty label removes it. The folder never
# changes, so a running session keeps its login. Exit 2: bad label, 3: no such account.
cmd_porcelain_rename() {
  name=${1:-}
  label=$(printf '%s' "${2-}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  case "$name" in
    default) ;;
    codex:*)
      cname=${name#codex:}
      if [ "$cname" = default ]; then :
      elif valid_name "$cname" && [ -d "$HOME/.codex-accounts/$cname" ]; then :
      else die_as 3 "No Codex account $cname."
      fi
      ;;
    *)
      if valid_name "$name" && [ -d "$HOME/.claude-accounts/$name" ]; then :
      elif model_exists "$name"; then :
      else die_as 3 "No account $name."
      fi
      ;;
  esac
  if [ -n "$label" ]; then
    valid_label "$label" || die_as 2 "A label is 1 to 24 characters, with no tabs or newlines."
  fi
  mkdir -p "$TOWER" || die_as 1 "Could not create $TOWER."
  tmp="$TOWER/.labels.$$"
  {
    if [ -r "$LABELS" ]; then
      awk -F '\t' -v n="$name" '$1 != n' "$LABELS"
    fi
    if [ -n "$label" ]; then
      printf '%s\t%s\n' "$name" "$label"
    fi
  } > "$tmp" || { rm -f "$tmp"; die_as 1 "Could not write $LABELS."; }
  mv "$tmp" "$LABELS" || { rm -f "$tmp"; die_as 1 "Could not write $LABELS."; }
  printf '%s\n' "${label:-$name}"
}

# The shell hook: an interactive shell turns a bare `claude` into the global default account.
# It reads the choice file with the builtin `read` and starts no other process.
cmd_shell_init() {
  cat <<'EOF'
# cca shell-init
# A model id as the default changes nothing here: only an existing ~/.claude-accounts/<name>
# folder is applied, so a bare `claude` stays on ~/.claude.
claude() {
  local _cca_cur=
  if [ -z "${CLAUDE_CONFIG_DIR:-}" ] && [ -z "${CCA_ACCOUNT:-}" ]; then
    if [ -r "${XDG_STATE_HOME:-$HOME/.local/state}/herdr-tower/current" ]; then
      read -r _cca_cur < "${XDG_STATE_HOME:-$HOME/.local/state}/herdr-tower/current" || [ -n "$_cca_cur" ] || _cca_cur=
    fi
    case "$_cca_cur" in
      ''|*[!A-Za-z0-9_-]*|default|ls|add|share|use|current|shell-init|help) _cca_cur= ;;
    esac
    if [ -n "$_cca_cur" ] && [ -d "$HOME/.claude-accounts/$_cca_cur" ]; then
      CLAUDE_CONFIG_DIR="$HOME/.claude-accounts/$_cca_cur" command claude "$@"
      return
    fi
  fi
  command claude "$@"
}
codex() {
  local _cca_codex=
  if [ -z "${CODEX_HOME:-}" ]; then
    if [ -r "${XDG_STATE_HOME:-$HOME/.local/state}/herdr-tower/codex-current" ]; then
      read -r _cca_codex < "${XDG_STATE_HOME:-$HOME/.local/state}/herdr-tower/codex-current" || [ -n "$_cca_codex" ] || _cca_codex=
    fi
    case "$_cca_codex" in
      ''|*[!A-Za-z0-9_-]*|default|codex|ls|add|share|use|current|shell-init|help) _cca_codex= ;;
    esac
    if [ -n "$_cca_codex" ] && [ -d "$HOME/.codex-accounts/$_cca_codex" ]; then
      CODEX_HOME="$HOME/.codex-accounts/$_cca_codex" command codex "$@"
      return
    fi
  fi
  command codex "$@"
}
EOF
}

cmd_help() {
  cat <<'EOF'
cca — Claude Code accounts

  cca, cca ls          list accounts with their usage and the most 5h headroom
  cca ls --json        the same as one line of JSON for tidemark
  cca <name> [args…]   run claude under <name>; default means ~/.claude with
                       CLAUDE_CONFIG_DIR unset (cca work -c continues here)
  cca use <name>       make <name> the default for every new session
  cca current          print that default
  cca shell-init       the claude() shell function that applies it; eval it
                       from ~/.zshrc to make a new shell start under it
  cca add <name>       create ~/.claude-accounts/<name>, sharing config and history
  cca share <name>     link the shared history into an account made before sharing
                       existed; --dry-run prints the plan first
  cca codex use <name> make ~/.codex-accounts/<name> the Codex login for new
                       sessions; default means ~/.codex
  cca codex add <name> create ~/.codex-accounts/<name>, linking ~/.codex's config
                       and history into it
  cca help             this text

Names: letters, digits, - and _.
Usage files: ${XDG_STATE_HOME:-$HOME/.local/state}/herdr-tower/usage/
Default for new sessions: ${XDG_STATE_HOME:-$HOME/.local/state}/herdr-tower/current
Codex default for new sessions: ${XDG_STATE_HOME:-$HOME/.local/state}/herdr-tower/codex-current
EOF
}

case "${1:-}" in
  '') cmd_ls ;;
  ls) shift; cmd_ls "$@" ;;
  help|-h|--help) cmd_help ;;
  add) shift; cmd_add "${1:-}" ;;
  share) shift; cmd_share "$@" ;;
  use) shift; cmd_use "${1:-}" ;;
  codex) shift; cmd_codex "$@" ;;
  current) cmd_current ;;
  shell-init) cmd_shell_init ;;
  --porcelain) shift; cmd_porcelain "${1:-}" ;;
  --porcelain-add) shift; cmd_porcelain_add "${1:-}" ;;
  --porcelain-add-codex) shift; cmd_porcelain_add_codex "${1:-}" ;;
  --porcelain-add-model) shift; cmd_porcelain_add_model "${1-}" "${2-}" ;;
  --porcelain-rename) shift; cmd_porcelain_rename "${1:-}" "${2-}" ;;
  --*) die "unknown option $1" ;;
  *) cmd_run "$@" ;;
esac
